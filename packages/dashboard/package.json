{
    "name": "@neuralfog/flow-dashboard",
    "version": "0.1.0",
    "license": "MIT",
    "author": "brownhounds",
    "type": "module",
    "imports": {
        "#src/*": "./src/*"
    },
    "scripts": {
        "dev": "elemix-ssr dev",
        "start": "bun run src/index.ts",
        "build": "elemix-ssr build",
        "run": "NODE_ENV=production bun run ./dist/index.js",
        "preview": "pn build && pn run run",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . && pnpm lint:tpl && pnpm typecheck && pnpm lint:analyze",
        "lint:analyze": "ea --dirs src --root .",
        "lint:tpl": "etf --dirs src",
        "lint:fix": "biome check --write . && etf --dirs src --write"
    },
    "devDependencies": {
        "@neuralfog/elemix-analyzer": "link:../../../elemix/packages/analyzer",
        "@neuralfog/elemix-template-formatter": "0.9.5",
        "@biomejs/biome": "2.5.5",
        "@types/bun": "1.3.14",
        "@types/pg": "8.23.1",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "@neuralfog/elemix": "link:../../../elemix/packages/elemix",
        "@neuralfog/elemix-ssr-plugin": "link:../../../elemix/packages/ssr-plugin",
        "@neuralfog/hydris": "link:../../../elemix/packages/hydris",
        "@neuralfog/flow": "workspace:*",
        "pg": "8.23.0"
    }
}
